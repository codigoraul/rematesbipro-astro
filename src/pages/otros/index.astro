---
import Layout from '../../layouts/Layout.astro';
import { getOtros, getFeaturedImage, getField, formatPrecio, formatFecha } from '../../lib/wordpress.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const otros = await getOtros();
---

<Layout
  title="Remate de Excedentes de Construcción en Los Ángeles y alrededores"
  description="Excedentes de construcción, materiales, equipos y otros bienes en remate en Los Ángeles y alrededores. Revisa precios base, fechas de remate y participa con Remates BiPro."
  canonical="https://rematesbipro.cl/otros"
>

  <!-- HERO -->
  <section class="bg-primary text-white py-10">
    <div class="max-w-7xl mx-auto px-5">
      <div class="flex items-center gap-3 mb-1">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z" stroke="white" stroke-width="1.8" stroke-linejoin="round"/>
          <circle cx="7" cy="7" r="1.5" fill="white"/>
        </svg>
        <h1 class="text-2xl font-bold tracking-tight">Excedentes de Construcción</h1>
      </div>
      <p class="text-blue-200 text-sm">{otros.length} artículo{otros.length !== 1 ? 's' : ''} disponible{otros.length !== 1 ? 's' : ''}</p>
    </div>
  </section>

  <!-- BANNER REMATE DESTACADO -->
  <section class="bg-gradient-to-r from-[#012A6C] to-[#011f52] relative overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image:radial-gradient(circle at 20% 50%, white 1px, transparent 1px);background-size:22px 22px;"></div>
    <div class="max-w-7xl mx-auto px-5 py-5 relative flex flex-col md:flex-row items-center gap-4 md:gap-6">
      <div class="flex items-center gap-3 shrink-0">
        <span class="bg-orange-500 text-white text-[11px] font-bold px-3 py-1.5 rounded-full uppercase tracking-widest animate-pulse">Remate activo</span>
        <div class="bg-white/10 border border-white/20 rounded-xl px-4 py-2 text-center">
          <p class="text-white/60 text-[10px] uppercase tracking-wider leading-none mb-1">Fecha</p>
          <p class="text-white font-extrabold text-sm leading-none">05 Sept · 12:00 hrs</p>
        </div>
      </div>

      <div class="flex-1 min-w-0 text-center md:text-left">
        <h2 class="text-white font-extrabold text-xl md:text-2xl leading-tight">
          Gran Remate de <span class="text-orange-500">Excedentes de Construcción</span>
        </h2>
        <p class="text-blue-100 text-sm mt-1">
          Visitas: 28-29 de agosto y 4-5 de septiembre &nbsp;·&nbsp; No te pierdas esta oportunidad
        </p>
        <p class="text-blue-100 text-sm mt-1 flex items-center justify-center md:justify-start gap-1.5">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21c-4.418-4.03-7-7.44-7-10.5A7 7 0 0112 3a7 7 0 017 7.5c0 3.06-2.582 6.47-7 10.5z"/><circle cx="12" cy="10.5" r="2.5"/></svg>
          Calle Esmeralda con Errázuriz, sector Aurora de Chile, Concepción
        </p>
      </div>

      <div class="flex flex-col gap-2 shrink-0 w-full md:w-auto items-center md:items-stretch">
        <a href={`${base}/docs/bases-remate-excedentes-construccion.pdf`} target="_blank" rel="noopener"
           class="bg-orange-500 hover:bg-orange-600 text-white font-bold px-5 py-2 rounded-xl transition shadow-lg text-sm flex items-center justify-center gap-2 w-full">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6M9 8h1M7 3h10a2 2 0 012 2v14a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2z"/></svg>
          Ver bases del remate
        </a>
        <a href={`${base}/docs/lista-lotes-excedentes-construccion.pdf`} target="_blank" rel="noopener"
           class="bg-white text-[#012A6C] hover:bg-orange-500 hover:text-white font-bold px-5 py-2 rounded-xl transition shadow-lg text-sm flex items-center justify-center gap-2 w-full border border-white/30">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/></svg>
          Listado de lotes
        </a>
      </div>
    </div>
  </section>

  <!-- LISTADO -->
  <main class="max-w-7xl mx-auto px-5 py-10">
    {otros.length === 0 ? (
      <div class="text-center py-20 text-gray-400">
        <svg class="mx-auto mb-4 opacity-30" width="64" height="64" viewBox="0 0 24 24" fill="none">
          <path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
        </svg>
        <p class="text-lg font-medium text-gray-500">No hay artículos disponibles</p>
        <p class="text-sm mt-1">Vuelve pronto para ver nuevos remates</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {otros.map((o) => {
          const img       = getFeaturedImage(o);
          const categoria = getField(o, 'categoria_item');
          const descripcion = getField(o, 'descripcion');
          const precio    = getField(o, 'precio_base');
          const fecha     = getField(o, 'fecha_remate');
          return (
            <a href={`${base}/otros/${o.slug}`} class="remate-card bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 hover:border-primary/30 block">
              <div class="relative overflow-hidden" style="height:200px">
                {img
                  ? <img src={img} alt={o.title?.rendered || 'Artículo'} class="w-full h-full object-cover" loading="lazy" />
                  : <div class="w-full h-full bg-gray-100 flex items-center justify-center text-gray-300">
                      <svg width="48" height="48" viewBox="0 0 24 24" fill="none">
                        <path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                      </svg>
                    </div>
                }
                {fecha && (
                  <span class="absolute top-3 right-3 bg-accent text-white text-xs font-semibold px-2.5 py-1 rounded-full">
                    {formatFecha(fecha)}
                  </span>
                )}
                {categoria && (
                  <span class="absolute top-3 left-3 bg-white/90 text-gray-700 text-xs font-medium px-2 py-0.5 rounded-full border border-gray-200">
                    {categoria}
                  </span>
                )}
              </div>
              <div class="p-4">
                <h2 class="font-bold text-gray-900 text-base leading-tight truncate">
                  {o.title?.rendered}
                </h2>
                {descripcion && (
                  <p class="text-xs text-gray-500 mt-1 line-clamp-2">{descripcion}</p>
                )}
                <p class="text-accent font-extrabold text-xl mt-3">{formatPrecio(precio)}</p>
              </div>
            </a>
          );
        })}
      </div>
    )}
  </main>

</Layout>
